# Drizzle migration tooling only. Copy to .env (ignored) and replace placeholders.
# Use the direct, non-pooled URL for the same branch/database as DATABASE_URL.
# Prefer a migration role with DDL permissions; do not give the runtime role DDL.
DATABASE_URL_UNPOOLED="postgresql://MIGRATION_ROLE:REPLACE_ME@ep-EXAMPLE.REGION.aws.neon.tech/prometheus_dental_clinic?sslmode=require"

# No VITE_* variables are required. They are public; never use them for secrets.
