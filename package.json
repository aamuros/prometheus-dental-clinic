{
  "name": "prometheus-dental-clinic",
  "version": "0.0.0",
  "private": true,
  "description": "Prometheus Dental Clinic management system built with React, Hono, Cloudflare Workers, and Neon PostgreSQL.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:vercel": "vite build --mode vercel",
    "db:generate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:verify": "node scripts/verify-database-runtime.mjs",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "auth:verify": "node scripts/verify-auth-runtime.mjs",
    "patients:smoke-data": "tsx scripts/patient-smoke-data.ts",
    "appointments:smoke-data": "tsx scripts/appointment-smoke-data.ts",
    "dental-records:smoke-data": "tsx scripts/dental-record-smoke-data.ts",
    "cf:types": "wrangler types worker/bindings.d.ts --env-interface WorkerBindings --include-runtime false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "preview": "pnpm build && vite preview --host 127.0.0.1",
    "deploy:check": "pnpm check && wrangler deploy --dry-run",
    "deploy": "pnpm check && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-router": "1.170.41",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@eslint/js": "10.0.1",
    "@neon/config": "1.8.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
